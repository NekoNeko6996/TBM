{
  "manifest_version": 3,
  "name": "TBM",
  "version": "1.1.0",
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "favicon" 
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Workspace Aside"
  }
}